# PostgreSQL — set postgres user password to match before running migrations
DATABASE_URL="postgresql://postgres:victoriahotel@localhost:5432/victoria_hotel?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="usd"

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_CURRENCY="usd"

# Local testing without Stripe — books instantly as confirmed
ALLOW_DEV_BOOKING="true"

# Admin session signing secret
ADMIN_SESSION_SECRET="change-this-secret"

# Admin seed (used by prisma/seed.ts on first run)
ADMIN_EMAIL="admin@victoriahotel.et"
ADMIN_PASSWORD="changeme"
ADMIN_NAME="Hotel Admin"

# Email (optional — uses Resend; logs to console in dev without API key)
RESEND_API_KEY=""
EMAIL_FROM="Victoria Hotel <bookings@victoriahotel.et>"
